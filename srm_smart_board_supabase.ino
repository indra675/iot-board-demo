  $('#hum').textContent=Math.round(w.current.relative_humidity_2m)+' %';}catch(e){}
 try{const a=await (await fetch('https://air-quality-api.open-meteo.com/v1/air-quality?latitude='+L.lat+'&longitude='+L.lon+'&current=us_aqi')).json();
  const v=Math.round(a.current.us_aqi);$('#aqi').textContent=v;$('#aql').textContent=aqiLabel(v);}catch(e){}
}
function ytId(u){const m=u.match(/(?:youtu\.be\/|v=|embed\/|shorts\/)([\w-]{11})/);return m?m[1]:null;}

const ROLE=document.body.dataset.role;
const HDR=t=>({apikey:SB_KEY,Authorization:'Bearer '+(t||SB_KEY),'Content-Type':'application/json'});
const TOK=()=>{try{return sessionStorage.getItem('srmTok')||'';}catch(e){return '';}};
const IS_ADMIN=()=>!!TOK();
const PUB=SB_URL+'/storage/v1/object/public/board/';
function msg(t){const m=$('#msg');if(m)m.textContent=t;}
function logout(){try{sessionStorage.removeItem('srmTok');}catch(e){}location.reload();}
async function sb(path,opt){const r=await fetch(SB_URL+path,opt);
 if(r.status==401&&TOK()){logout();}return r;}

/* ---- special day (settings table, key = special) ---- */
async function special(){
 let t='';try{const r=await sb('/rest/v1/settings?key=eq.special&select=value',{headers:HDR()});
  const j=await r.json();if(j&&j[0])t=(j[0].value||'').trim();}catch(e){}
 if(!t){const n=new Date(),p=x=>String(x).padStart(2,'0');
  const k=n.getFullYear()+'-'+p(n.getMonth()+1)+'-'+p(n.getDate());
  t=FEST[k]||FEST[k.slice(5)]||'No special day today';}
 $('#sp').textContent=t;
}

/* ---- notices (posts table) ---- */
function card(p,i){
 const d=p.data;let b='',a='';
 const FS='<button class="pill gold" onclick="fsMedia(this)">Full screen</button>';
 const DL='<button class="pill" onclick="dl(\''+esc(d)+'\')">Download</button>';
 if(p.type=='text')b='<p class="txt">'+esc(d)+'</p>';
 else if(p.type=='image'){b='<img src="'+esc(d)+'" alt="">';a=DL+FS;}
 else if(p.type=='video'){b='<video src="'+esc(d)+'" controls playsinline></video>';a=DL+FS;}
 else{const y=ytId(d);
  if(y){b='<iframe src="https://www.youtube.com/embed/'+y+'" allowfullscreen></iframe>';a=FS;}
  else if(/^https?:\/\//i.test(d))a='<a class="pill gold" target="_blank" rel="noopener" href="'+esc(d)+'">Open link</a>';
  else b='<p class="txt">'+esc(d)+'</p>';}
 if(ROLE=='admin'&&IS_ADMIN())a+='<button class="pill red" onclick="delPost('+(+p.id)+')">Delete</button>';
 return '<div class="post" style="animation-delay:'+Math.min(i,8)*.07+'s">'+(p.title?'<h3>'+esc(p.title)+'</h3>':'')+b+(a?'<div class="acts">'+a+'</div>':'')+'</div>';
}
let lastPosts='';
function fsBoard(){const el=$('.board');
 if(document.fullscreenElement)document.exitFullscreen();else(el.requestFullscreen||el.webkitRequestFullscreen).call(el);}
function fsMedia(b){const m=b.closest('.post').querySelector('img,video,iframe');(m.requestFullscreen||m.webkitRequestFullscreen).call(m);}
document.addEventListener('fullscreenchange',()=>{const b=$('#fsb');if(b)b.textContent=document.fullscreenElement==$('.board')?'Exit full screen':'Full screen';});
async function dl(u){try{const b=await (await fetch(u)).blob(),a=document.createElement('a');
 a.href=URL.createObjectURL(b);a.download=u.split('/').pop();document.body.appendChild(a);a.click();a.remove();}
 catch(e){window.open(u,'_blank');}}
async function loadPosts(){
 try{const txt=await (await sb('/rest/v1/posts?select=*&order=id.desc',{headers:HDR(TOK()),cache:'no-store'})).text();
  if(txt===lastPosts)return;
  const fe=document.fullscreenElement;if(fe&&fe!=$('.board')&&$('#posts').contains(fe))return;
  lastPosts=txt;const a=JSON.parse(txt);
  $('#posts').innerHTML=a.length?a.map(card).join(''):'<div class="empty">Welcome to the SRM Smart Board. No notices yet.</div>';}catch(e){}
}
async function delPost(id){if(!confirm('Delete this post?'))return;
 try{const r=await sb('/rest/v1/posts?id=eq.'+id+'&select=type,data',{method:'DELETE',headers:{...HDR(TOK()),Prefer:'return=representation'}});
  const j=await r.json();
  if(j&&j[0]&&(j[0].type=='image'||j[0].type=='video')&&j[0].data.indexOf(PUB)==0)
   await sb('/storage/v1/object/board/'+j[0].data.slice(PUB.length),{method:'DELETE',headers:HDR(TOK())});
 }catch(e){}
 lastPosts='';loadPosts();}
function shrink(file){return new Promise((ok,no)=>{const im=new Image();im.onload=()=>{const k=Math.min(1,1280/Math.max(im.width,im.height)),c=document.createElement('canvas');
 c.width=im.width*k;c.height=im.height*k;c.getContext('2d').drawImage(im,0,0,c.width,c.height);c.toBlob(ok,'image/jpeg',.8);};im.onerror=no;im.src=URL.createObjectURL(file);});}

/* ---- admin ---- */
async function adminZone(){
 const z=$('#adminzone');
 if(!IS_ADMIN()){
  $('#main').classList.add('locked');
  z.innerHTML=`<div class="panel login"><h2>Admin Login</h2>
  <input id="uid" placeholder="User ID" autocomplete="username">
  <input id="pw" type="password" placeholder="Password" autocomplete="current-password">
  <button class="pill" id="lg">Login</button><div id="msg"></div></div>`;
  const go=async()=>{let id=$('#uid').value.trim();if(id.indexOf('@')<0)id+='@'+ADMIN_DOMAIN;
   msg('Checking...');
   try{const r=await fetch(SB_URL+'/auth/v1/token?grant_type=password',{method:'POST',headers:{apikey:SB_KEY,'Content-Type':'application/json'},body:JSON.stringify({email:id,password:$('#pw').value})});
    const j=await r.json();
    if(r.ok&&j.access_token){try{sessionStorage.setItem('srmTok',j.access_token);}catch(e){}location.reload();}
    else msg('Wrong ID or password');}catch(e){msg('Cannot reach Supabase - check internet');}};
  $('#lg').onclick=go;$('#pw').onkeydown=e=>{if(e.key=='Enter')go();};
  return;
 }
 z.innerHTML=`<div class="panel"><div class="row"><h2>Admin Panel</h2><button class="pill red" id="lo">Logout</button></div>
 <label>Title (optional)</label><input id="ptitle" maxlength="80" placeholder="e.g. Tomorrow's workshop">
 <label>Type</label><select id="ptype"><option value="text">Text</option><option value="image">Image</option>
 <option value="video">Video file</option><option value="link">YouTube / Web link</option></select>
 <div id="boxText"><label>Text</label><textarea id="pdata" rows="4" maxlength="1200" placeholder="Type message to display..."></textarea></div>
 <div id="boxFile" style="display:none"><label>Choose file (video max ~50 MB on the free plan)</label><input id="pfile" type="file"></div>
 <button class="pill gold" id="pb">Publish</button><span id="msg"></span>
 <hr>
 <label>Special day override (leave empty = automatic)</label>
 <input id="spin" maxlength="80" placeholder="e.g. Annual Day">
 <button class="pill" id="spb">Save special day</button></div>`;
 const sync=()=>{const t=$('#ptype').value;
  $('#boxText').style.display=(t=='text'||t=='link')?'block':'none';
  $('#boxFile').style.display=(t=='image'||t=='video')?'block':'none';
  $('#pfile').accept=t=='image'?'image/*':'video/*';
  $('#pdata').placeholder=t=='link'?'https://youtu.be/... or any https link':'Type message to display...';};
 $('#ptype').onchange=sync;
 $('#lo').onclick=logout;
 $('#spb').onclick=async()=>{const v=$('#spin').value.trim();
  if(v)await sb('/rest/v1/settings',{method:'POST',headers:{...HDR(TOK()),Prefer:'resolution=merge-duplicates'},body:JSON.stringify({key:'special',value:v})});
  else await sb('/rest/v1/settings?key=eq.special',{method:'DELETE',headers:HDR(TOK())});
  special();msg('Saved');};
 $('#pb').onclick=async()=>{
  const type=$('#ptype').value,title=$('#ptitle').value.trim();let data='';
  if(type=='text'||type=='link')data=$('#pdata').value.trim();
  else{let f=$('#pfile').files[0];if(!f){msg('Choose a file first');return;}
   msg('Uploading... please wait');
   try{if(type=='image')f=await shrink(f);
    const ext=type=='image'?'jpg':((($('#pfile').files[0].name.split('.').pop())||'mp4').replace(/[^a-z0-9]/gi,'').slice(0,5)||'mp4');
    const name='u'+Date.now()+'.'+ext;
    const r=await sb('/storage/v1/object/board/'+name,{method:'POST',headers:{apikey:SB_KEY,Authorization:'Bearer '+TOK(),'Content-Type':f.type||'application/octet-stream'},body:f});
    if(!r.ok){msg('Upload failed - file too big or storage full');return;}
    data=PUB+name;}catch(e){msg('Upload failed');return;}}
  if(!data){msg('Nothing to publish');return;}
  const r2=await sb('/rest/v1/posts',{method:'POST',headers:HDR(TOK()),body:JSON.stringify({title,type,data})});
  if(!r2.ok){msg('Could not save post');return;}
  msg('Published');$('#pdata').value='';$('#ptitle').value='';$('#pfile').value='';lastPosts='';loadPosts();};
 sb('/rest/v1/settings?key=eq.special&select=value',{headers:HDR()}).then(r=>r.json()).then(j=>{if(j&&j[0])$('#spin').value=j[0].value;}).catch(()=>{});
 sync();
}
splash();shell();tick();setInterval(tick,1000);
(async()=>{if(ROLE=='admin')await adminZone();loadPosts();special();env();
 setInterval(loadPosts,10000);setInterval(env,600000);setInterval(special,60000);})();
)rawliteral";


// =========================== HELPERS ======================================
void sendNoCache() { server.sendHeader("Cache-Control", "no-store"); }

void printLinks() {
  Serial.println();
  Serial.println("--------------- OPEN THESE LINKS ---------------");
  Serial.println("USER  page : http://" + boardIP + "/");
  Serial.println("ADMIN page : http://" + boardIP + "/admin");
  Serial.println("Also try   : http://srmboard.local/   |   http://srmboard.local/admin");
  Serial.println("Data       : Supabase cloud database (works from anywhere)");
  Serial.println("------------------------------------------------");
}

// =============================== SETUP ====================================
void setup() {
  Serial.begin(115200);
  delay(300);
  Serial.println("\n\n=== SRM University AP | Smart Board (ESP8266 + Supabase) ===");

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  Serial.print("Connecting to WiFi");
  uint32_t t0 = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t0 < 20000) { delay(400); Serial.print("."); }
  Serial.println();

  String ip;
  if (WiFi.status() == WL_CONNECTED) {
    ip = WiFi.localIP().toString();
  } else {
    Serial.println("WiFi failed -> own hotspot (no internet, so cloud data will NOT load)");
    WiFi.mode(WIFI_AP);
    WiFi.softAP("SRM-SmartBoard", "12345678");
    ip = WiFi.softAPIP().toString();
  }
  boardIP = ip;
  MDNS.begin("srmboard");

  server.on("/", HTTP_GET, []() { server.send_P(200, "text/html", PAGE_USER); });
  server.on("/admin", HTTP_GET, []() { sendNoCache(); server.send_P(200, "text/html", PAGE_ADMIN); });
  server.on("/style.css", HTTP_GET, []() { server.send_P(200, "text/css", STYLE_CSS); });
  server.on("/app.js", HTTP_GET, []() {
    // settings are placed in front of the app code, so you only edit them at the top of this file
    sendNoCache();
    server.setContentLength(CONTENT_LENGTH_UNKNOWN);
    server.send(200, "application/javascript", "");
    server.sendContent("const SB_URL='" + String(SUPABASE_URL) + "',SB_KEY='" + String(SUPABASE_ANON_KEY) +
                       "',ADMIN_DOMAIN='" + String(ADMIN_DOMAIN) + "';\n");
    server.sendContent_P(APP_JS);
    server.sendContent("");
  });
  server.on("/logo.jpg", HTTP_GET, []() {
    server.sendHeader("Cache-Control", "max-age=86400");
    server.send_P(200, "image/jpeg", (PGM_P)SRM_LOGO, sizeof(SRM_LOGO));
  });
  server.onNotFound([]() { server.send(404, "text/plain", "Not found"); });
  server.begin();

  printLinks();
}

void loop() {
  server.handleClient();
  if (millis() - lastPrint > 10000) { lastPrint = millis(); printLinks(); }   // repeats every 10 s
  MDNS.update();
}
